# 复制为 .env 后按需修改（供 docker compose 读取）
TAG=latest
ENVIRONMENT=production
PUBLIC_WEB_ORIGIN=http://localhost:3000
WEB_PORT=3000
API_PORT=8000

# 用户签名时展示的域名，通常等于 PUBLIC_WEB_ORIGIN 去掉协议
SIWE_DOMAIN=localhost:3000

# 登录态 JWT 签名密钥，务必改成随机长字符串
# 生成示例：openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# 默认使用容器内命名卷的 SQLite；如需 Postgres 可覆盖，例如
# DATABASE_URL=postgresql+psycopg://user:pass@db:5432/bupt3dao
# DATABASE_URL=sqlite:////data/app.db
