# 复制为 .env 后按需修改
ENVIRONMENT=local
CORS_ORIGINS=["http://localhost:3000"]

# 数据库：默认 SQLite（文件在 ./data/app.db，目录会自动创建）
DATABASE_URL=sqlite:///./data/app.db

# 钱包登录（SIWE / EIP-4361）
# domain 必须与用户实际访问站点的 host 一致，否则前端签名页展示的域名会对不上
SIWE_DOMAIN=localhost:3000
SIWE_URI=http://localhost:3000
SIWE_STATEMENT=登录 BUPT3DAO 社区
SIWE_CHAIN_ID=1

# 登录态 JWT 密钥，生产环境务必替换为随机长字符串
# 生成示例：openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me
# 管理员公开钱包地址（JSON 数组）；默认无人拥有管理员权限
ADMIN_ADDRESSES=[]

# 头像上传
UPLOAD_DIR=./data/uploads
MAX_AVATAR_BYTES=2097152
